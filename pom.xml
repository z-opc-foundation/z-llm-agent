<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        z-llm-agent —— CLI Agent 服务化（一个产品，一个仓）。

        血缘：上游 feature-team/future-llm-agent（五模块 reactor）→ z 化后寄居 z-team 仓；
        2026-10-26 起独立成仓，proxy 模块归位回本 reactor。
        同日独立仓 z-agent-proxy（三方 agent 适配，Cursor/Aider → z-agent-kernel SPI，
        Central 止于 0.1.1）整体挂入为第六模块，artifactId 不变续坐标血缘。

        六个模块：
        - z-llm-agent-common   DTO、错误码（零运行时依赖）
        - z-llm-agent-proxy    本地 CLI 代理：自动发现本机 CLI（claude/hermes/qoder 等），
                               OpenAI 兼容流式 API，shade fat jar 独立运行 + Nacos 注册
        - z-agent-proxy        三方 agent 适配代理（Cursor/Operator/Aider/Codeium/Continue
                               → z-agent-kernel Agent SPI）
        - z-llm-agent-core     CliAgentService 门面、proxy 生命周期、代码仓磁盘运维
        - z-llm-agent-client   HTTP SDK（CliAgentClient）
        - z-llm-agent-starter  可运行 Spring Boot 进程（repackage 出 *-boot.jar）

        版本线：接 Central 上 z-team 发的 1.0.46，起点 1.0.47，与 z-team 解耦
        （z-team 侧 DM 已把本家族五坐标全部钉死在 1.0.46）。
    -->
    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-boot-parent</artifactId>
        <version>1.1.2</version>
        <relativePath/>
    </parent>

    <groupId>io.github.yuku123</groupId>
    <artifactId>z-llm-agent</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>

    <name>z-llm-agent (CLI Agent as a Service)</name>
    <description>CLI Agent 服务化：把本机 CLI agent（Claude Code / Hermes / Qoder 等）暴露成 OpenAI 兼容对话 API，含 REST 门面、HTTP Client SDK 与 Spring Boot 进程封装</description>

    <url>https://github.com/z-opc-foundation/z-llm-agent</url>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>yuku123</id>
            <name>yuku123</name>
            <email>1340947819@qq.com</email>
            <organization>z-opc-foundation</organization>
            <organizationUrl>https://github.com/z-opc-foundation</organizationUrl>
            <timezone>+08:00</timezone>
            <roles><role>owner</role></roles>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/z-opc-foundation/z-llm-agent.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/z-opc-foundation/z-llm-agent.git</developerConnection>
        <url>https://github.com/z-opc-foundation/z-llm-agent</url>
        <tag>HEAD</tag>
    </scm>

    <modules>
        <module>z-llm-agent-common</module>
        <module>z-llm-agent-proxy</module>
        <module>z-agent-proxy</module>
        <module>z-llm-agent-core</module>
        <module>z-llm-agent-client</module>
        <module>z-llm-agent-starter</module>
    </modules>

    <properties>
        <!-- CI-friendly 版本根。接 Central 上 z-team 发的 1.0.46，不断线。 -->
        <revision>1.0.47</revision>

        <!-- 兄弟仓坐标：z-boot-parent 不管这两条线，必须在此写死。
             抬版前先确认 Central 已有目标版本，否则构建硬失败。 -->
        <z-team-agent-core.version>1.0.46</z-team-agent-core.version>
        <z-llm-msghub-client.version>1.0.46</z-llm-msghub-client.version>
        <!-- z-util 1.2.x 线（见 DM 内注释）；不占用 z-util.version——那会连带 z-util-expr-* 家族 -->
        <z-util-line.version>1.2.4</z-util-line.version>
    </properties>

    <!-- 本机 settings.xml 把 central 镜像到 aliyun，而 aliyun 对本组织新发构件同步滞后
         （实测 z-llm-msghub-client:1.0.46 镜像 404、repo1 200）。
         这里显式加 repo1 直连：mirrorOf=central 只拦截 id=central 的仓，不影响本条。 -->
    <repositories>
        <repository>
            <id>repo1-direct</id>
            <url>https://repo1.maven.org/maven2</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <!-- 本仓兄弟仓坐标统一在此钉版，子模块只写 groupId/artifactId -->
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-team-agent-core</artifactId>
                <version>${z-team-agent-core.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-llm-msghub-client</artifactId>
                <version>${z-llm-msghub-client.version}</version>
            </dependency>
            <!-- z-util 三件套钉 1.2.4：z-boot-parent（1.1.0/1.1.2 同）的 DM 按 1.0.22 解析，
                 而 1.0.22 的 JsonUtil 没有 parse()，z-llm-agent-core 会当场编译失败。
                 1.2.4 与 z-team 原 DM 同值（ObjectMapper 迁到 z-util 自研 JSON API 那一轮），原样平移。 -->
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-util-core</artifactId>
                <version>${z-util-line.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-util-parser-json</artifactId>
                <version>${z-util-line.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.yuku123</groupId>
                <artifactId>z-util-dsl-kernel</artifactId>
                <version>${z-util-line.version}</version>
            </dependency>
            <!-- snakeyaml 钉 2.3（z-team 1.0.9 同款修法平移）：jackson-dataformat-yaml 2.18.6
                 要 ParserImpl.(StreamReader, LoaderOptions) 构造器，父链地板只给 1.30
                 ⇒ HermesClaudeConfigLoaderTest 6 例运行时 NoSuchMethodError（单模块绿、全量红）。
                 也高于 z-meta/z-mq/z-gw 为压 CVE-2022-1471 抄来的 2.0（低于 jackson 下限，照抄照样炸）。 -->
            <dependency>
                <groupId>org.yaml</groupId>
                <artifactId>snakeyaml</artifactId>
                <version>2.3</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- 全仓统一测试台（parent <dependencies> 直供，所有子模块自动继承；
         版本由父链的 junit-bom 下发。z-team 时代这面台子挂在 z-team 根 pom，
         平移过来后本仓自备，否则各模块的 org.junit.jupiter 测试源码编译不过） -->
    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.vintage</groupId>
            <artifactId>junit-vintage-engine</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <source>1.8</source>
                        <target>1.8</target>
                        <proc>none</proc>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- parent 的 flatten 是 inherited=false，不会下发 ⇒ 本仓自己常开，
                 否则发出去的 pom 会带着 z-boot-parent 出厂。 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>${flatten-maven-plugin.version}</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>oss</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals><goal>flatten</goal></goals>
                    </execution>
                    <execution>
                        <id>flatten-clean</id>
                        <phase>clean</phase>
                        <goals><goal>clean</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- 发布 Maven Central 专用 profile：bash _doc/003_script/deploy_maven_center.sh
         结构照抄 z-util 的实战版（见 lead/003_辅助能力/maven-central-publish 与踩坑记录）：
         - deploy-plugin skip + central-publishing-maven-plugin 接管，不会重复 deploy
         - javadoc doclint=none（Java 8 的 HTML5 校验必炸，Central 又强制要 javadoc.jar）
         - antrun 剔掉 JDK 自带 javadoc 静态资产（DejaVu 字体那批，占 javadoc 体积 78%，
           体积大了会被 central.sonatype.com 前面的 Cloudflare 100 秒掐断，实测 524）
         - gpg 3.2.8 不读 -Dgpg.passphrase，必须走仓内 gpg-with-passphrase.sh 预喂
         - keyring 用仓内 .gnupg（GNUPGHOME 由发布脚本 export），私钥与 z-util 同一把 -->
    <profiles>
        <profile>
            <id>central</id>
            <properties>
                <!-- true 跳过 javadoc / GPG（本地 dry-run 用）；真发 Central 时 false -->
                <maven.javadoc.skip>false</maven.javadoc.skip>
                <central.gpg.skip>false</central.gpg.skip>
                <!-- 发布包瘦身：Central 只发库件坐标，两个 fat jar 不上 Central
                     （proxy shaded 44MB + starter boot 126MB，bundle 合计 155MB，
                     本机实测上行 0.13MB/s ⇒ 上传 2.5 分钟即被 central.sonatype.com
                     前面的 Cloudflare 掐断 Broken pipe，1.0.47 三连发全死在这）。
                     fat jar 可随时本地 `mvn package` 复现，属部署产物而非消费坐标。
                     z-team 时代 1.0.46 的 boot.jar 是在快网环境发的，不具可复制性。 -->
                <!-- shade 插件 3.5.1 的 skip 参数**没有绑定命令行属性**（plugin.xml 里
                     <skip implementation="boolean" default-value="false"/>，无 expression），
                     -Dshade.skip 是哑弹，必须在下面用显式插件配置关掉。
                     spring-boot 的 repackage 有 spring-boot.repackage.skip 属性，上面够用。 -->
                <spring-boot.repackage.skip>true</spring-boot.repackage.skip>
            </properties>
            <distributionManagement>
                <repository>
                    <id>central</id>
                    <url>https://central.sonatype.com</url>
                </repository>
                <snapshotRepository>
                    <id>central</id>
                    <url>https://central.sonatype.com</url>
                </snapshotRepository>
            </distributionManagement>
            <build>
                <plugins>
                    <!-- 中央发布场景禁用 maven-deploy-plugin 的 default-deploy，
                         改由 central-publishing-maven-plugin 接管（避免重复 deploy） -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-deploy-plugin</artifactId>
                        <version>3.1.4</version>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </plugin>

                    <!-- Central 强制要求 sources.jar -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.2.1</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- Central 强制要求 javadoc.jar；doclint=none 规避 Java 8+ HTML5 校验 -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.11.2</version>
                        <configuration>
                            <doclint>none</doclint>
                            <failOnError>false</failOnError>
                            <failOnWarnings>false</failOnWarnings>
                            <quiet>true</quiet>
                            <source>1.8</source>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- 剔掉 javadoc.jar 里 JDK 自带的静态资产（resource-files/script-files 等）。
                         目录名随 JDK 大版本变，所以「有就剔、没有（zip 12）就算过」，两个布局都试。 -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>strip-javadoc-resource-files</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>run</goal>
                                </goals>
                                <configuration>
                                    <target>
                                        <exec executable="sh" failonerror="true">
                                            <arg value="-c"/>
                                            <arg value="jar=&quot;${project.build.directory}/${project.build.finalName}-javadoc.jar&quot;; test -f &quot;$jar&quot; || exit 0; zip -q -d &quot;$jar&quot; 'resource-files/*' 'script-files/*'; rc=$?; [ &quot;$rc&quot; -eq 0 ] || [ &quot;$rc&quot; -eq 12 ]"/>
                                        </exec>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- 发布包瘦身：Central 只发库件坐标，proxy 的 shaded fat jar 不上 Central
                         （44MB；连同 starter boot.jar 126MB 曾把 bundle 撑到 155MB，
                         本机实测上行 0.13MB/s ⇒ 上传 2.5 分钟即被 central.sonatype.com
                         前面的 Cloudflare 掐断 Broken pipe，1.0.47 三连发全死在这）。
                         fat jar 可随时本地 `mvn package` 复现，属部署产物而非消费坐标。
                         z-team 时代 1.0.46 的 fat jar 是在快网环境发的，不具可复制性。 -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-shade-plugin</artifactId>
                        <configuration>
                            <skip>true</skip>
                        </configuration>
                    </plugin>

                    <!-- GPG 签名：3.2.8 不读 -Dgpg.passphrase，由仓内 wrapper 预喂
                         （headless macOS 上默认 gpg-agent 必撞 No pinentry） -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <configuration>
                            <skip>${central.gpg.skip}</skip>
                            <executable>${maven.multiModuleProjectDirectory}/_doc/003_script/gpg-with-passphrase.sh</executable>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- Central Portal 上传插件（替代老的 nexus-staging）。
                         五个模块全进 bundle（与 z-team 时代 1.0.46 的发布面一致），无需 excludeArtifacts -->
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.7.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <tokenAuth>true</tokenAuth>
                            <autoPublish>true</autoPublish>
                            <waitUntil>uploaded</waitUntil>
                            <waitMaxTime>1800</waitMaxTime>
                            <waitPollingInterval>10</waitPollingInterval>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
