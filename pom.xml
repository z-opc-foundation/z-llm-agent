<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        z-llm-agent-proxy —— 原 z-team/z-llm-agent/z-llm-agent-proxy 子模块，2026-10-26 平移成独立仓。

        形态：服务（单模块 jar + shade fat jar），不是库 —— 产出物是 `java -jar` 可跑的进程。

        平移时保留的东西：
          - 包名 com.zifang.z.team.agent.proxy 原样不动（改动面太大，且它是内部包，无对外 API 承诺）；
          - 所有依赖与 shade 过滤器原样保留（里面有踩过坑的注释，别删）。

        平移时改掉的东西：
          - parent：z-llm-agent（relativePath ../pom.xml）→ z-boot-parent（relativePath 留空，在 repo1）；
          - 版本：原来继承 z-team 的 ${revision}，现在本仓自持，起点 1.0.47（接着 Central 上的 1.0.46）；
          - z-team-agent-core 必须显式写版本（原来由 z-team 父 DM 管，z-boot-parent 不管兄弟仓的 agent 线）。
    -->
    <parent>
        <groupId>io.github.yuku123</groupId>
        <artifactId>z-boot-parent</artifactId>
        <version>1.1.2</version>
        <relativePath/>
    </parent>

    <groupId>io.github.yuku123</groupId>
    <artifactId>z-llm-agent-proxy</artifactId>
    <version>${revision}</version>
    <packaging>jar</packaging>
    <name>z-llm-agent-proxy (CLI Agent Proxy)</name>
    <description>
        Standalone CLI proxy: auto-discover local CLI agents, expose OpenAI-compatible streaming chat API.
        把本机 CLI agent（Claude Code / Qoder / Hermes / Opencode / Minimax）暴露成 OpenAI 兼容
        streaming chat API，并向 Nacos 注册。Wrapper 层已合入本模块。
    </description>

    <url>https://github.com/z-opc-foundation/z-llm-agent-proxy</url>
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>yuku123</id>
            <name>yuku123</name>
            <email>1340947819@qq.com</email>
            <organization>z-opc-foundation</organization>
            <organizationUrl>https://github.com/z-opc-foundation</organizationUrl>
            <timezone>+08:00</timezone>
            <roles><role>owner</role></roles>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/z-opc-foundation/z-llm-agent-proxy.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/z-opc-foundation/z-llm-agent-proxy.git</developerConnection>
        <url>https://github.com/z-opc-foundation/z-llm-agent-proxy</url>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <!-- CI-friendly 版本根。起点接 Central 上已有的 1.0.46，不与历史断线。 -->
        <revision>1.0.47</revision>
        <!-- z-boot-parent 不管兄弟仓的 agent 线，这里必须写死；Central 实测最新 1.0.46 -->
        <z-team-agent-core.version>1.0.46</z-team-agent-core.version>
        <log4j2.version>2.20.0</log4j2.version>
        <maven-enforcer-plugin.version>3.4.1</maven-enforcer-plugin.version>
    </properties>

    <dependencies>
        <!-- 复用 core 的 CliAgentConfig / CliAgentRegistry / ChatCompletionRequest / Response DTO -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-team-agent-core</artifactId>
            <version>${z-team-agent-core.version}</version>
        </dependency>

        <!-- JSON 解析（StreamJsonParser / ProxyChatHandler 用，与 core 统一） -->
        <!-- YAML 配置解析（MinimaxConfigLoader 读 ~/.hermes/config.yaml） -->
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
        </dependency>
        <!-- jackson-dataformat-yaml 2.13.x 依赖 snakeyaml 1.x API，classpath 上的 2.0 会 NoSuchMethod -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Nacos 服务注册（proxy 启动后将自己注册到 Nacos） -->
        <dependency>
            <groupId>com.alibaba.nacos</groupId>
            <artifactId>nacos-client</artifactId>
        </dependency>
        <!-- z-util-parser-json (替换 fastjson: 提供 JsonUtil + JsonObject + JsonArray) -->
        <dependency>
            <groupId>io.github.yuku123</groupId>
            <artifactId>z-util-parser-json</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>z-llm-agent-proxy</finalName>
        <plugins>
            <!-- 刻意不加 enforcer 的"日志绑定唯一性"规则：那是给 Spring 服务用的。
                 本仓用 java.util.logging，且 z-team-agent-core → z-agent-engine → spring-boot-starter
                 会把 spring-boot-starter-logging 带进编译期 classpath（shade 的
                 `org/springframework/**` 过滤器保证它不进 fat jar）。加了这条规则会当场把构建拦死，
                 而它防的问题在本仓不存在。 -->

            <!-- fat JAR 打包（原样保留：里面的排除项是踩过坑的，别删） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.zifang.z.team.agent.proxy.ProxyApplication</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <!-- FEATURE054: 不打包 mybatis/mybatis-plus/spring 生态 jar,
                                             避免 fat jar 作为依赖被引入下游服务时, 内部类加载器优先读到旧版,
                                             与下游声明的 mybatis 3.5.16 冲突 (Configuration.setNullableOnForEach 缺失).
                                             这些 jar 下游会显式提供, proxy 仅使用 CompileApi. -->
                                        <exclude>org/apache/ibatis/**</exclude>
                                        <exclude>org/mybatis/**</exclude>
                                        <exclude>org/mybatis/spring/**</exclude>
                                        <exclude>com/baomidou/**</exclude>
                                        <exclude>org/springframework/**</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                    <proc>none</proc>
                </configuration>
            </plugin>

            <!-- parent 的 flatten 是 inherited=false，不会下发 ⇒ 本仓自己常开，
                 否则发出去的 pom 会带着 z-boot-parent 出厂。 -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>${flatten-maven-plugin.version}</version>
                <configuration>
                    <updatePomFile>true</updatePomFile>
                    <flattenMode>oss</flattenMode>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals><goal>flatten</goal></goals>
                    </execution>
                    <execution>
                        <id>flatten-clean</id>
                        <phase>clean</phase>
                        <goals><goal>clean</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
